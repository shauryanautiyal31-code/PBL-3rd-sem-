using namespace std;
struct Vehicle {
string number;
string owner;
long long entryTime=0;
};

clas ParkingSlot {
private:
int slotNumber;
bool occupied;
Vehicle vehicle;

public:
explicit ParkingSlot(int number =0):slotNumber(number),occupied(false),vehicle{} {}

int getSlotNumber() const {return slotNumber;}
bool isOccupied() const {return occupied;}
const Vehicle& getVehicle() const{return vehicle;}

void parkVehicle(const Vehicle& v) {
vehicle = v;
occupied = true;
}

Vehicle removeVehicle() {
Vehicle removed = vehicle;
vehicle = Vehicle{};
occupied = false;
retuen removed ;
}
};

class ParkingManager {
private:
static constexpr int SLOT_COUNT = 10;
vector<ParkingSlot>slots;
queue<Vehicle>waitingQueue;
const string dataFile = "parking_data.txt";
const string historyFile="parking_history.txt";

static string uperCase(string text) {
for(char& ch : text) {
ch=static_cast<char>(toupper(static_cast<unsigned char>(ch)));
}
return text;
}

static string cleanField(string text) {
 // The file uses | as a field separator.
 replace(text.begin(), text.end(), '|', '/');
 return text;
}
static string timeString(long long stamp) {
 if (stamp <= 0) return "Unknown";
 time_t t = static_cast<time_t>(stamp);
 tm* local = localtime(&t);
 if (!local) return "Unknown";
 ostringstream out;
 out << put_time(local, "%Y-%m-%d %H:%M:%S");
 return out.str();
}
void logAction(const string& action, const Vehicle&
v, int slotNumber = 0) const {
 ofstream file(historyFile, ios::app);
 if (!file) {
 cerr << "Warning: could not write to " <<
historyFile << ".\n";
 return;
 }
 file << timeString(static_cast<long
long>(time(nullptr))) << " | "
 << action << " | " << v.number << " | " <<
v.owner;
 if (slotNumber > 0) file << " | Slot " <<
slotNumber;
 file << '\n';
}
int findFreeSlotIndex() const {
 for (size_t i = 0; i < slots.size(); ++i) {
 if (!slots[i].isOccupied()) return static_cast<int>(i);
 }
 return -1;
}
bool existsInParkingOrQueue(const string& number)
const {
 for (const auto& slot : slots) {
 if (slot.isOccupied() && slot.getVehicle().number == number) return true;
 }
 queue<Vehicle> copy = waitingQueue;
 while (!copy.empty()) {
 if (copy.front().number == number) return true;
 copy.pop();
 }
 return false;
}
static int partitionVehicles(vector<Vehicle>& arr,
int low, int high) {
 string pivot = arr[high].number;
 int i = low - 1;
 for (int j = low; j < high; ++j) {
 if (arr[j].number <= pivot) {
++i;
 swap(arr[i], arr[j]);
 }
 }
 swap(arr[i + 1], arr[high]);
 return i + 1;
}
    static void quickSort(vector<Vehicle>& arr, int low, int high) {
        if (low < high) {
            int pivotIndex = partitionVehicles(arr, low, high);
            quickSort(arr, low, pivotIndex - 1);
            quickSort(arr, pivotIndex + 1, high);
        }
    }

    vector<Vehicle> parkedVehiclesSorted() const {
        vector<Vehicle> result;
        for (const auto& slot : slots) {
            if (slot.isOccupied()) result.push_back(slot.getVehicle());
        }
        if (!result.empty()) {
            quickSort(result, 0, static_cast<int>(result.size()) - 1);
        }
        return result;
    }

    void saveData() const {
        ofstream file(dataFile);
        if (!file) {
            cerr << "Error: could not save data to " << dataFile << ".\n";
            return;
        }

        for (const auto& slot : slots) {
            if (slot.isOccupied()) {
                const Vehicle& v = slot.getVehicle();
                file << "PARKED|" << slot.getSlotNumber() << '|'
                     << cleanField(v.number) << '|'
                     << cleanField(v.owner) << '|'
                     << v.entryTime << '\n';
            }
        }

        queue<Vehicle> copy = waitingQueue;
        while (!copy.empty()) {
            const Vehicle v = copy.front();
            copy.pop();
            file << "WAITING|0|" << cleanField(v.number) << '|'
                 << cleanField(v.owner) << '|' << v.entryTime << '\n';
        }
    }

    void loadData() {
        ifstream file(dataFile);
        if (!file) return; // First run: no saved data yet.

        string line;
        while (getline(file, line)) {
            stringstream ss(line);
            string type, slotText, number, owner, timeText;
            if (!getline(ss, type, '|') ||
                !getline(ss, slotText, '|') ||
                !getline(ss, number, '|') ||
                !getline(ss, owner, '|') ||
                !getline(ss, timeText)) {
                continue;
            }

            try {
                long long stamp = stoll(timeText);
                Vehicle v{upperCase(number), owner, stamp};

                if (type == "PARKED") {
                    int slotNo = stoi(slotText);
                    if (slotNo >= 1 && slotNo <= static_cast<int>(slots.size()) &&
                        !slots[slotNo - 1].isOccupied()) {
                        slots[slotNo - 1].parkVehicle(v);
                    }
                } else if (type == "WAITING") {
                    waitingQueue.push(v);
                }
            } catch (...) {
                // Ignore malformed records so one bad line won't stop startup.
            }
        }
    }

    static bool binarySearchByNumber(const vector<Vehicle>& sorted, const string& number,
                                     size_t& foundIndex) {
        size_t left = 0, right = sorted.size();
        while (left < right) {
            size_t mid = left + (right - left) / 2;
            if (sorted[mid].number == number) {
                foundIndex = mid;
                return true;
            }
            if (sorted[mid].number < number) left = mid + 1;
            else right = mid;
        }
        return false;
    }

    void printVehicle(const Vehicle& v, const string& status) const {
        cout << "Vehicle number : " << v.number << '\n'
             << "Owner name     : " << v.owner << '\n'
             << "Entry time     : " << timeString(v.entryTime) << '\n'
             << "Status         : " << status << '\n';
    }

public:
    ParkingManager() {
        for (int i = 1; i <= SLOT_COUNT; ++i) slots.emplace_back(i);
        loadData();
    }

    void displaySlots() const {
        cout << "\n========== PARKING SLOT STATUS ==========\n";
        int available = 0;
        for (const auto& slot : slots) {
            cout << "Slot " << setw(2) << slot.getSlotNumber() << " : ";
            if (slot.isOccupied()) {
                cout << "OCCUPIED (" << slot.getVehicle().number << ")\n";
            } else {
                cout << "AVAILABLE\n";
                ++available;
            }
        }
        cout << "Available slots: " << available
             << " / " << slots.size() << '\n';
        cout << "Vehicles waiting: " << waitingQueue.size() << '\n';
    }













